# Normalizza gli a-capo (LF) cosi' i file di Godot non generano diff
# "falsi" quando vengono modificati da Linux e da Windows.
* text=auto eol=lf

*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.import text eol=lf
*.godot text eol=lf
*.md text eol=lf
*.svg text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.wav binary
*.ogg binary
*.mp3 binary
*.ttf binary
*.otf binary
